  "version": "1.0.0",
  "description": "مدار اليقين | Madar Al-Yaqeen - منصة إسلامية رقمية عالمية فاخرة",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
